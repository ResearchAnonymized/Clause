# Copy to the server as `.env` next to docker-compose.prod.yml.
# Never commit the filled file.

NODE_ENV=production
APP_HOST=demo.yourdomain.com
APP_URL=https://demo.yourdomain.com
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
AUTH_SIGNUP_MODE=invite-only

# Optional — leave blank until you have a legal entity
OPERATOR_LEGAL_NAME=
PRIVACY_EMAIL=
SECURITY_EMAIL=

# Postgres (used by compose for the db container and DATABASE_URL rewrite)
POSTGRES_PASSWORD=REPLACE_STRONG_DB_PASSWORD
DATABASE_URL=postgres://clause:REPLACE_STRONG_DB_PASSWORD@db:5432/clause

# MinIO (S3)
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=eu-central-1
STORAGE_ACCESS_KEY=clause
STORAGE_SECRET_KEY=REPLACE_STRONG_MINIO_PASSWORD
STORAGE_BUCKET=contracts
STORAGE_FORCE_PATH_STYLE=true

# OpenRouter (or other OpenAI-compatible gateway)
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=sk-or-v1-REPLACE
AI_DEFAULT_MODEL=openrouter/auto
AI_COST_TIER=medium
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
# Optional cluster split: chat on GPU inference, embeddings on another OpenAI-compatible URL.
# AI_EMBEDDING_BASE_URL=http://inference:8000/v1
# AI_EMBEDDING_API_KEY=

# Invites and password reset. Without SMTP the operator copies the link.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Counterpart <noreply@usecounterpart.com>

CRON_SECRET=REPLACE_RANDOM
