# Copy to /opt/clause/.env and fill in real values.
# Never commit the real .env.

NODE_ENV=production
APP_URL=https://demo.yourdomain.com
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_STRING

# Must match docker-compose Postgres user/password/db
DATABASE_URL=postgres://clause:REPLACE_STRONG_DB_PASSWORD@127.0.0.1:5432/clause

# MinIO (localhost only — see deploy/docker-compose.demo.yml)
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=eu-central-1
STORAGE_ACCESS_KEY=clause
STORAGE_SECRET_KEY=REPLACE_STRONG_MINIO_PASSWORD
STORAGE_BUCKET=contracts
STORAGE_FORCE_PATH_STYLE=true

# OpenRouter (or other OpenAI-compatible gateway)
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=sk-or-v1-REPLACE
AI_DEFAULT_MODEL=openai/gpt-4o-mini
AI_EMBEDDING_MODEL=openai/text-embedding-3-small

# Leave empty for inline TS pipeline
WORKER_URL=
WORKER_SHARED_SECRET=

CRON_SECRET=REPLACE_RANDOM
