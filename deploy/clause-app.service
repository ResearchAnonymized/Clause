[Unit]
Description=Clause demo app
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/clause
EnvironmentFile=/opt/clause/.env
ExecStart=/usr/bin/pnpm exec vite preview --host 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
