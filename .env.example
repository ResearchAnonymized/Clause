# App
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string
AUTH_SIGNUP_MODE=invite-only
# open | invite-only | off  — first user on an empty instance can always sign up.

# Optional operator identity on legal pages (leave blank until you have an entity)
OPERATOR_LEGAL_NAME=
PRIVACY_EMAIL=
SECURITY_EMAIL=

# Postgres
DATABASE_URL=postgres://clause:clause@localhost:5432/clause

# Object storage (MinIO / S3-compatible)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=clause
STORAGE_SECRET_KEY=clause-secret
STORAGE_BUCKET=contracts
STORAGE_FORCE_PATH_STYLE=true

# AI (OpenAI-compatible) — required for analysis / embeddings
# OpenRouter:
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_API_KEY=sk-or-v1-...          ← paste your key here (not on AI_BASE_URL)
#   AI_DEFAULT_MODEL=openrouter/auto  ← Auto Router picks a model per task
#   AI_COST_TIER=medium               ← low | medium | high | xhigh | max
#   AI_EMBEDDING_MODEL=openai/text-embedding-3-small
#   AI_OCR_MODEL=google/gemini-2.5-flash
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
AI_DEFAULT_MODEL=openrouter/auto
AI_COST_TIER=medium
# Optional: separate embeddings endpoint (defaults to AI_BASE_URL / AI_API_KEY).
# Use this on OpenShift when chat runs on a cluster GPU and embeddings stay elsewhere.
# AI_EMBEDDING_BASE_URL=
# AI_EMBEDDING_API_KEY=

# Transactional mail (invites, password reset). Without this, links are only logged.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Counterpart <noreply@example.com>

# Cron
CRON_SECRET=dev-cron-secret
